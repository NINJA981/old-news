{
  "name": "old-news",
  "version": "0.1.0",
  "description": "Fades the paragraphs you've already read, across sites, and lights up what changed. On-device, 0 network requests.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "postinstall": "wxt prepare",
    "assets": "tsx scripts/copy-assets.ts",
    "dev": "pnpm assets && wxt",
    "dev:firefox": "pnpm assets && wxt -b firefox --mv3",
    "build": "pnpm assets && wxt build",
    "build:firefox": "pnpm assets && wxt build -b firefox --mv3",
    "zip": "pnpm assets && wxt zip",
    "fetch-model": "tsx scripts/fetch-model.ts",
    "eval": "tsx scripts/eval-corpus.ts",
    "size": "pnpm zip && tsx scripts/size-report.ts",
    "check-tokens": "tsx scripts/check-tokens.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "tsx scripts/screenshots.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@huggingface/transformers": "4.3.1",
    "@mozilla/readability": "0.6.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "cmdk": "1.1.1",
    "idb": "8.0.4",
    "lucide-react": "1.62.0",
    "motion": "14.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/chrome": "0.3.5",
    "@types/culori": "4.0.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "culori": "4.0.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "linkedom": "0.18.13",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wxt": "0.21.4"
  }
}
